# Copy to .env and fill in. Never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Dedicated secrets (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SIGNING_KEY=
UNIVERSITY_HMAC_KEY=
# Fernet key(s) for anonymous identities: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ANONYMOUS_IDENTITY_KEYS=

# Infrastructure
DATABASE_URL=postgres://university:university@localhost:5432/university
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Number of trusted reverse proxies in front of the app (0 = none)
TRUSTED_PROXY_COUNT=0

FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=University <no-reply@example.com>

# CORS (explicit origins only)
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMS provider, e.g. university.core.providers.sms.TermiiSMSProvider
SMS_PROVIDER=university.core.providers.sms.ConsoleSMSProvider
SMS_API_KEY=
SMS_SENDER_ID=University
